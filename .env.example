# Local defaults for `cp .env.example .env`.
# docker-compose.yml injects its own DATABASE_URL and REDIS_URL (service DNS).
# Placeholders are not real credentials. Do not commit a filled-in .env.

DATABASE_URL=postgresql+asyncpg://signalforge:signalforge@localhost:5432/signalforge
REDIS_URL=redis://localhost:6379/0

HELIUS_API_KEY=replace-me
# Full Authorization header value Helius echoes from the webhook authHeader.
HELIUS_WEBHOOK_SECRET=replace-me
# Public Helius hosts. The API key stays in HELIUS_API_KEY, not in these URLs.
HELIUS_API_BASE_URL=https://api.helius.xyz
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
RAYDIUM_API_BASE_URL=https://api-v3.raydium.io
# Token from @BotFather. The worker polls Telegram only when this value is
# set and is not the placeholder replace-me. Leave the placeholder for local
# API/worker startup without a bot.
TELEGRAM_BOT_TOKEN=replace-me
ANTHROPIC_API_KEY=replace-me
TWITTER_BEARER_TOKEN=replace-me

# Public REST API. The worker does not read this. replace-me disables the API
# (503) until a real key is set. Send it as the X-API-Key header.
PUBLIC_API_KEY=replace-me
# Requests per minute for one API key. Fixed one-minute window in Redis.
API_RATE_LIMIT_PER_MINUTE=60

# dev or prod
ENVIRONMENT=dev

# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO
